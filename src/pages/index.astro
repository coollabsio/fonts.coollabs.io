---
import Layout from "../layouts/Layout.astro";
import BigSponsors from "./big-sponsors.astro";
---

<Layout title="coolLabs Fonts">
  <h1 class="text-3xl font-bold tracking-tight text-white md:text-6xl px-4">
    Privacy for your visitors<span class="text-warning">.</span>
  </h1>
  <h2 class="text-base pt-2 text-neutral-400 px-4">
    A privacy-friendly drop-in replacement for Google Fonts.
  </h2>
  <div
    class="pb-6 pt-4 text-xs flex gap-2 gap-2 justify-center flex-row flex-wrap"
  >
    <a
      class="text-white hover:underline cursor-pointer text-white flex gap-2 items-center justify-center text-xs"
      target="_blank"
      href="https://twitch.tv/heyandras"
    >
      <i class="ph-duotone ph-twitch-logo text-purple-500 text-base" aria-hidden="true"></i>

      Building in live-streams</a
    >
  </div>
  <div
    class="flex flex-col md:flex-row gap-4 text-center items-center justify-center"
  >
    <div class="text-base font-extrabold tracking-tight text-white">
      In your <span class="font-bold text-warning">head</span> tags, change:
    </div>
    <div
      class="tracking-tight text-white font-mono bg-coolgray-300 px-4 py-2 rounded text-sm"
    >
      fonts.googleapis.com
    </div>
    <div class="text-base font-extrabold tracking-tight text-white">to:</div>
    <div class="flex justify-center">
      <div
        class="tracking-tight text-white font-mono bg-coolgray-300 px-4 py-2 rounded text-sm"
      >
        api.fonts.coollabs.io
      </div>
    </div>
  </div>
  <div
    class="text-base font-extrabold tracking-tight text-white sm:text-2xl pt-6"
  >
    That's all!
  </div>
  <div>
    <a
      href="https://github.com/coollabsio/fonts#how-to-use"
      target="_blank"
      class="tracking-tight text-gray-300 text-xs underline hover:text-white"
      >(see an example)</a
    >
  </div>

  <div class="pt-16 pb-8 px-4 flex gap-4 justify-center flex-wrap">
    <div class="rounded-xl border border-coolgray-400 bg-coolgray-200 py-8 px-12 flex-1 max-w-xs">
      <div class="text-3xl md:text-4xl font-extrabold text-white tabular-nums">7,000,000+</div>
      <div class="text-sm text-neutral-500 pt-2">Monthly Requests</div>
    </div>
    <div class="rounded-xl border border-coolgray-400 bg-coolgray-200 py-8 px-12 flex-1 max-w-xs">
      <div class="text-3xl md:text-4xl font-extrabold text-white">Millions</div>
      <div class="text-sm text-neutral-500 pt-2">Users Protected</div>
    </div>
  </div>
</Layout>
