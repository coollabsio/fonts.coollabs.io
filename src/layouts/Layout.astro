---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/android-launchericon-48-48.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="72x72"
      href="/android-launchericon-72-72.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/android-launchericon-96-96.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="144x144"
      href="/android-launchericon-144-144.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-launchericon-192-192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/android-launchericon-512-512.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#ffc40d" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta
      name="Description"
      content="coolLabs Fonts: A privacy-friendly drop-in replacement for Google Fonts"
    />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heyandras" />
    <meta name="twitter:title" content="coolLabs" />
    <meta
      name="twitter:description"
      content="coolLabs Fonts: A privacy-friendly drop-in replacement for Google Fonts"
    />
    <meta
      name="twitter:image"
      content="https://cdn.coollabs.io/og-images/fonts.png"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fonts.coollabs.io" />
    <meta property="og:title" content="coolLabs Fonts" />
    <meta
      property="og:description"
      content="coolLabs Fonts: A privacy-friendly drop-in replacement for Google Fonts"
    />
    <meta property="og:site_name" content="coolLabs Fonts" />
    <meta
      property="og:image"
      content="https://cdn.coollabs.io/og-images/fonts.png"
    />
    <title>{title}</title>
  </head>
  <body class="antialiased leading-relaxed overflow-x-hidden text-fg font-sans">
    <Navigation />
    <main class="max-w-6xl mx-auto">
      <div class="text-center pt-12 md:pt-20">
        <slot />
      </div>
    </main>
    <Footer />
    <style is:global>
      @reference "../styles/global.css";

      html {
        background-color: var(--color-app);
        color: var(--color-fg);
        color-scheme: dark;
        overflow-x: hidden;
      }
      @supports (overflow-x: clip) {
        html,
        body {
          overflow-x: clip;
        }
      }
      /* Accent glow at the top, same as the Coolify app login page (.auth-shell). */
      body {
        background:
          radial-gradient(circle at 50% 0%, color-mix(in oklab, var(--color-coollabs) 16%, transparent), transparent 36rem),
          var(--color-app);
      }
      ::selection {
        background: color-mix(in oklch, var(--color-coollabs) 45%, transparent);
      }
      .navbar-link {
        @apply text-fg-dim text-sm hover:text-fg hover:bg-white/[0.06] h-8 px-2.5 rounded-md flex items-center gap-2 transition-colors;
      }
      @media (max-width: 767px) {
        .navbar-link {
          @apply w-full text-left px-3 h-9;
        }
      }
    </style>

    <script
      async
      defer
      data-domain="fonts.coollabs.io"
      src="https://analytics.coollabs.io/js/plausible.js"></script>

    <script>
      const mobileMenuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");

      function toggleMobileMenu() {
        mobileMenu?.classList.toggle("hidden");
        mobileMenu?.classList.toggle("flex");
      }

      mobileMenuButton?.addEventListener("click", toggleMobileMenu);

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu?.classList.add("hidden");
          mobileMenu?.classList.remove("flex");
        });
      });
    </script>
  </body>
</html>
